<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>Here are a few of our partner organizations:</p>
    <ul class="card-grid">
        <% organizations.forEach(organization => { %>
            <li class="card">
                <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                <h2><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a></h2>
                <p><%= organization.description %></p>
                <p><%= organization.contact_email %></p>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>