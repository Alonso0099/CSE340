<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
  <div class="table-wrapper">
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Email (Username)</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(u => { %>
                <tr>
                    <td><%= u.name %></td>
                    <td><%= u.email %></td>
                    <td><%= u.role_name %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
  </div>
</main>

<%- include('partials/footer') %>