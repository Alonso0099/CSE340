<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <div class="card">
        <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
        <h2><%= organizationDetails.name %></h2>
        <p><%= organizationDetails.description %></p>
        <p><a href="mailto:<%= organizationDetails.contact_email %>"><%= organizationDetails.contact_email %></a></p>
    </div>

    <h3>Service Projects</h3>
    <% if (projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No service projects for this organization yet.</p>
    <% } %>
</main>

<%- include('partials/footer') %>