<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
        <div calss="card"
            <h2><%= project.title %></h2>
            <p><%= project.description %></p>
            <p>Location: <%= project.location %></p>
            <p>Date: <%= project.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
        </div>
        <h3>Categories</h3>
        <ul class="tag-list">
            <% categories.forEach(category => { %>
                <li><a class="tag" href="/category/<%= category.category_id %>"><%= category.name %></a></li>
            <% }); %>
        </ul>
</main>

<%- include('partials/footer') %>
