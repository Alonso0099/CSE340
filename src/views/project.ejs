<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <div class="card">
        <h2><%= project.title %></h2>
        <p><%= project.description %></p>
        <p>Location: <%= project.location %></p>
        <p>Date: <%= project.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
        <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    </div>

    <h3>Categories</h3>
    <ul class="tag-list">
        <% categories.forEach(category => { %>
            <li><a class="tag" href="/category/<%= category.category_id %>"><%= category.name %></a></li>
        <% }); %>
    </ul>
    <% if (user && user.role_name === 'admin') { %>
    <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
    <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>
